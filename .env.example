# Copie para .env e preencha. O .env NUNCA vai para o git.
# z.ai (plano gratuito) — endpoint compatível com OpenAI
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=coloque-sua-chave-aqui
# (também aceita ZAI_API_KEY no lugar de LLM_API_KEY)
# Modelos gratuitos da z.ai (linha Flash, com limite de requisições/minuto):
#   glm-4.7-flash (mais novo) · glm-4.5-flash
LLM_MODEL=glm-4.7-flash
# Pede resposta em JSON puro (response_format json_object). Desligue se o provedor reclamar.
LLM_JSON_MODE=true
# Campos extras enviados no corpo da requisição (JSON). Na z.ai, desligar o "thinking" reduz a latência.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
