{
  "name": "maestro",
  "version": "1.0.0",
  "description": "Live coding de música eletrônica com uma IA maestro",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --port 5173 --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "eval:ai": "vitest run --config vitest.eval.config.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/web": "^1.3.0",
    "@strudel/webaudio": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
